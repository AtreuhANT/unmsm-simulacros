# Copiar a .env y configurar valores propios. No subir .env a GitHub.
# PostgreSQL local; sustituir TU_PASSWORD (codificar caracteres especiales en la URL).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/simulacro_db
# Generar SECRET_KEY siguiendo README.md.
SECRET_KEY=
# Solo para Docker: definir ambos valores con la misma contrase?a.
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=
# Formato Docker: postgresql://postgres:TU_PASSWORD@db:5432/simulacro_db
FLASK_ENV=development
PORT=5000
DB_MIN_CONN=2
DB_MAX_CONN=35
# La duración de los nuevos simulacros se fija en config.py: 180 minutos.
# Detección de celular con cámara durante el examen (requiere consentimiento).
DETECCION_CELULAR_ACTIVA=1
